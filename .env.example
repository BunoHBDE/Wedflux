# Wedflux — variáveis de ambiente (copie para .env e preencha; nunca commite valores reais)

# --- App (Expo; prefixo EXPO_PUBLIC_ é embutido no app, então só valores públicos) ---
# URL do projeto Supabase (https://<ref>.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=
# Chave pública (anon/publishable) do Supabase
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Chave pública do RevenueCat para Android (goog_...)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# ID do projeto EAS (necessário para push com expo-notifications)
EXPO_PUBLIC_EAS_PROJECT_ID=

# --- Servidor / edge functions (NUNCA no app; configurar como secrets no Supabase) ---
# Chave service_role do Supabase
SUPABASE_SERVICE_ROLE_KEY=
# Segredo de autorização do webhook do RevenueCat
REVENUECAT_WEBHOOK_AUTH=
# Credenciais do FCM (service account) para envio do push
FCM_SERVICE_ACCOUNT_JSON=
